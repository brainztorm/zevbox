+ && test -x node_modules/.bin/codex-acp \
+ && test -x node_modules/.bin/codex \
+ && rm -f /usr/bin/bwrap
+
 FROM base AS antigravity
 ARG AGY_SHA256
 COPY agy.zip /tmp/agy.zip
